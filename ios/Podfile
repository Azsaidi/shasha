# VLC plays the formats Apple's player can't (.ts live streams, .mkv films, ...).
# VLCKit 4 (pre-release) is used for its picture-in-picture support.
platform :ios, '16.0'
use_frameworks!

target 'Shasha' do
  pod 'VLCKit', '4.0.0a18'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end
end
